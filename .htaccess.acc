AuthName "How are you?"
AuthType Basic  
Require valid-user
AuthUserFile "/var/www/pwd/.htpasswd" 


AddDefaultCharset utf-8
DirectoryIndex index.php index.html

#php_value session.gc_maxlifetime 900800
#php_value session.cookie_lifetime 900800

<IfModule mod_rewrite.c>
  RewriteEngine On

  # uncomment the following line, if you are having trouble
  # getting no_script_name to work
  RewriteBase /

  RewriteRule ^\/?spec\/([^\/]+)\/([A-Za-z]+)(\/[^\/]+)?\/?$ http://$2.lookmedbook.ru/doctor/$1/$3 [R=301,L]
  # RewriteRule ^\/?doctor\/?$ /doctor/terapevt [R=301,L]

  RewriteCond %{HTTP_HOST} ^moskva\.lookmedbook\.ru$ [NC]
  RewriteRule ^(.*)$ http://account.lookmedbook.ru/$1 [R=301,L]

  # no, so we redirect to our front web controller
#  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

RewriteEngine On 
RewriteCond %{HTTP_HOST} ^www\.lookmedbook\.ru$ [NC] 
RewriteCond %{REQUEST_URI} !^/robots\.txt$ 
RewriteRule ^(.*)$ http://lookmedbook.ru/$1 [R=301,L]

RewriteCond %{HTTP_HOST} ^www\.lookmedbook\.ru$ [NC]
RewriteCond %{REQUEST_URI} !^/booking/test\.xml$
RewriteRule ^(.*)$ http://lookmedbook.ru/$1 [R=301,L]

RewriteCond %{HTTP_HOST} ^www\.lookmedbook\.ru$ [NC]
RewriteCond %{REQUEST_URI} !^/yandex_5e37f2f3f5a8ea9d\.txt$
RewriteRule ^(.*)$ http://lookmedbook.ru/$1 [R=301,L]

ErrorDocument 404 /404.html

