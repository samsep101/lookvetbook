
AddDefaultCharset utf-8
DirectoryIndex index.php index.html

ErrorDocument 404 /404.html

#php_value session.gc_maxlifetime 900800
#php_value session.cookie_lifetime 900800

##RewriteRule ^\/?doctor\/?$ /doctor/terapevt [R=301,L]

<IfModule mod_rewrite.c>
  RewriteEngine On

  # uncomment the following line, if you are having trouble
  # getting no_script_name to work
  RewriteBase /

  RewriteRule ^\/?spec\/([^\/]+)\/([A-Za-z]+)(\/[^.]+)?\/?$ http://$2.lookvetbook.cyb/doctor/$1/$3 [R=301,L]

  RewriteCond %{HTTP_HOST} ^www\.lookvetbook\.cyb$ [NC]
  RewriteRule ^(.*)$ http://lookvetbook.cyb/$1 [R=301,L]

  RewriteCond %{HTTP_HOST} ^(.*)\.lookvetbook\.cyb$ [NC]
  RewriteRule ^robots\.txt$ robots/robots_%1.txt [L]

  RewriteCond %{HTTP_HOST} ^(.*)\.lookvetbook\.cyb$ [NC]
  RewriteRule ^yandex_([a-zA-Z0-9]+)\.html$ yandex_files/yandex_$1.html [L]

  RewriteCond %{HTTP_HOST} ^www\.lookvetbook\.cyb$ [NC]
  RewriteCond %{REQUEST_URI} !^/booking/test\.xml$
  RewriteRule ^(.*)$ http://lookvetbook.cyb/$1 [R=301,L]

  RewriteCond %{HTTP_HOST} ^www\.lookvetbook\.cyb$ [NC]
  RewriteCond %{REQUEST_URI} !^/yandex_5e37f2f3f5a8ea9d\.txt$
  RewriteRule ^(.*)$ http://lookvetbook.cyb/$1 [R=301,L]

  # no, so we redirect to our front web controller
#  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.*)$ index.php [QSA,L]

  AddEncoding gzip .gz
  RewriteCond %{HTTP:Accept-encoding} gzip
  RewriteCond %{HTTP_USER_AGENT} !Safari
  RewriteCond %{REQUEST_FILENAME}.gz -f
  RewriteRule ^(.*)$ $1.gz [QSA,L]

  RewriteCond %{HTTP:Accept-encoding} !gzip [OR]
  RewriteCond %{HTTP_USER_AGENT} Konqueror
  RewriteRule ^(.miniwd)\.(js)$ $1.nogzip.$2 [QSA,L]
  RewriteRule ^(.popups)\.(js)$ $1.nogzip.$2 [QSA,L]
  RewriteRule ^(.jquery-1.11.0.min)\.(js)$ $1.nogzip.$2 [QSA,L]

</IfModule>
     
<IfModule mod_headers.c>
    Header append Vary User-Agent
    <FilesMatch .*miniwd\.(js)$>
           Header set Content-Encoding: gzip
           Header set Cache-control: private
    </FilesMatch>
   <FilesMatch .*popups\.(js)$>
               Header set Content-Encoding: gzip
               Header set Cache-control: private
        </FilesMatch>
   <FilesMatch .*jquery-1.11.0.min\.(js)$>
         Header set Content-Encoding: gzip
         Header set Cache-control: private
   </FilesMatch>
  <FilesMatch .*\.nogzip\.(js|css)$>
         Header unset Content-Encoding
  </FilesMatch>
</IfModule>

